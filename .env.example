# Local development only. Change every secret before exposing publicly.
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USER=anwar
ADMIN_PASSWORD=change-this-password
HOST_NAME=Anwar
HOST_TZ=Africa/Cairo
DATABASE_URL=sqlite:////app/data/calendar.db
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
# Optional SMTP for confirmation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
