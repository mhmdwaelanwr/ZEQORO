# Local development only. Change every secret before exposing publicly.
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USER=anwar
ADMIN_PASSWORD=change-this-password
HOST_NAME=Anwar
HOST_TZ=Africa/Cairo
DATABASE_URL=sqlite:////app/data/calendar.db
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
# Optional SMTP for confirmation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Google Calendar / Meet (optional, self-hosted OAuth integration).
# Enable Google Calendar API in Google Cloud and configure OAuth web application.
# Keep these server-side only. Never commit real credentials to GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/admin/google/callback
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back up this key securely. Losing it makes saved refresh tokens undecryptable.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Production Compose (docker compose -f docker-compose.production.yml up -d --build)
# Use a fresh database. Password URL-encode reserved characters in DATABASE_URL.
# POSTGRES_PASSWORD=generate-a-long-random-password
# DATABASE_URL=postgresql+psycopg://zeqoro:URL_ENCODED_PASSWORD@db:5432/zeqoro
# REDIS_URL is injected privately by docker-compose.production.yml.
# Set APP_ENV=production, PUBLIC_BASE_URL=https://your-domain.example and COOKIE_SECURE=true.
# Configure trusted HTTPS reverse proxy separately; the app binds localhost only.

# Team workspace (v0.8): new records are created on application startup.
# Once deployed, keep TEAM_ORG_SLUG stable; changing it creates a second workspace.
TEAM_ORG_NAME=ZEQORO Team
TEAM_ORG_SLUG=zeqoro-team

# Team Google integration (v0.9): register BOTH redirect URLs in the Google OAuth web client:
#  http://localhost:8000/admin/google/callback (existing host connection)
#  http://localhost:8000/team/google/callback  (each team member's own account)
# false preserves existing team availability when some members haven't connected.
# true strictly requires every assigned member to connect their Google Calendar.
TEAM_GOOGLE_REQUIRE_CONNECTED=false

# ZEQORO v1.0: Multi-calendar / Google push notification worker.
# Reconnect member OAuth to grant calendar.calendarlist.readonly scope (calendar discovery).
# Public HTTPS URL is mandatory for Google webhook push channels.
# PUBLIC_BASE_URL=https://calendar.yourdomain.example
# Register and renew channels from /team/google; POST receiver: /webhooks/google/calendar.
# Only expose webhook through a trusted HTTPS reverse proxy; keep Redis/Postgres internal.
